{
  "name": "gridly",
  "version": "1.0.0",
  "private": true,
  "description": "Gridly casual colour matching game",
  "scripts": {
    "prepare:web": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});for(const f of ['index.html','style.css','shop.css','game.js','manifest.json','icon.svg'])fs.copyFileSync(f,'www/'+f)\"",
    "cap:sync": "npm run prepare:web && npx cap sync android",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3"
  }
}
